# -*- coding: mbcs -*-
from mesh import *
from visualization import *
mdb.Model(name='Task9_Rectangular_Plate_Tension')
mdb.models['Task9_Rectangular_Plate_Tension'].ConstrainedSketch(name=
    'plate_profile', sheetSize=2.0)
mdb.models['Task9_Rectangular_Plate_Tension'].sketches['plate_profile'].rectangle(
    point1=(0.0, 0.0), point2=(1.0, 0.4))
mdb.models['Task9_Rectangular_Plate_Tension'].Part(dimensionality=TWO_D_PLANAR, 
    name='Plate', type=DEFORMABLE_BODY)
mdb.models['Task9_Rectangular_Plate_Tension'].parts['Plate'].BaseShell(sketch=
    mdb.models['Task9_Rectangular_Plate_Tension'].sketches['plate_profile'])
mdb.models['Task9_Rectangular_Plate_Tension'].Material(name=
    'Steel_linear_elastic')
mdb.models['Task9_Rectangular_Plate_Tension'].materials['Steel_linear_elastic'].Elastic(
    table=((210000000000.0, 0.3), ))
mdb.models['Task9_Rectangular_Plate_Tension'].HomogeneousSolidSection(material=
    'Steel_linear_elastic', name='Plane_stress_section', thickness=0.01)
mdb.models['Task9_Rectangular_Plate_Tension'].parts['Plate'].Set(faces=
    mdb.models['Task9_Rectangular_Plate_Tension'].parts['Plate'].faces.getSequenceFromMask(
    mask=('[#1 ]', ), ), name='Plate_all')
mdb.models['Task9_Rectangular_Plate_Tension'].parts['Plate'].SectionAssignment(
    region=
    mdb.models['Task9_Rectangular_Plate_Tension'].parts['Plate'].sets['Plate_all']
    , sectionName='Plane_stress_section')
mdb.models['Task9_Rectangular_Plate_Tension'].parts['Plate'].seedPart(
    deviationFactor=0.1, minSizeFactor=0.1, size=0.05)
mdb.models['Task9_Rectangular_Plate_Tension'].parts['Plate'].setMeshControls(
    elemShape=TRI, regions=
    mdb.models['Task9_Rectangular_Plate_Tension'].parts['Plate'].faces.getSequenceFromMask(
    mask=('[#1 ]', ), ), technique=FREE)
mdb.models['Task9_Rectangular_Plate_Tension'].parts['Plate'].setElementType(
    elemTypes=(ElemType(elemCode=CPS3, elemLibrary=STANDARD), ), regions=(
    mdb.models['Task9_Rectangular_Plate_Tension'].parts['Plate'].faces.getSequenceFromMask(
    mask=('[#1 ]', ), ), ))
mdb.models['Task9_Rectangular_Plate_Tension'].parts['Plate'].generateMesh()
mdb.models['Task9_Rectangular_Plate_Tension'].rootAssembly.DatumCsysByDefault(
    CARTESIAN)
mdb.models['Task9_Rectangular_Plate_Tension'].rootAssembly.Instance(dependent=
    ON, name='Plate-1', part=
    mdb.models['Task9_Rectangular_Plate_Tension'].parts['Plate'])
mdb.models['Task9_Rectangular_Plate_Tension'].rootAssembly.Set(edges=
    mdb.models['Task9_Rectangular_Plate_Tension'].rootAssembly.instances['Plate-1'].edges.getSequenceFromMask(
    mask=('[#8 ]', ), ), name='LeftEdge')
mdb.models['Task9_Rectangular_Plate_Tension'].rootAssembly.Set(edges=
    mdb.models['Task9_Rectangular_Plate_Tension'].rootAssembly.instances['Plate-1'].edges.getSequenceFromMask(
    mask=('[#2 ]', ), ), name='RightEdge')
mdb.models['Task9_Rectangular_Plate_Tension'].StaticStep(name='Load', nlgeom=
    OFF, previous='Initial')
