mdb.models['Task7_Axial_Bar_2Elem'].Material(name='Steel_E200GPa')
mdb.models['Task7_Axial_Bar_2Elem'].materials['Steel_E200GPa'].Elastic(table=((
    200000.0, 0.3), ))
mdb.models['Task7_Axial_Bar_2Elem'].TrussSection(area=100.0, material=
    'Steel_E200GPa', name='BarSection')
mdb.models['Task7_Axial_Bar_2Elem'].parts['Bar_1D_T2D2'].SectionAssignment(
    region=
    mdb.models['Task7_Axial_Bar_2Elem'].parts['Bar_1D_T2D2'].sets['ALL_ELEMS'], 
    sectionName='BarSection')
mdb.models['Task7_Axial_Bar_2Elem'].parts['Bar_1D_T2D2'].seedPart(
    deviationFactor=0.1, minSizeFactor=0.1, size=500.0)
del mdb.models['Task7_Axial_Bar_2Elem']
mdb.Model(name='Task7_Axial_Bar_2Elem')
mdb.models['Task7_Axial_Bar_2Elem'].Part(dimensionality=TWO_D_PLANAR, name=
