del mdb.models['Model-1']
mdb.Model(name='ExampleB_1Elem')
mdb.models['ExampleB_1Elem'].ConstrainedSketch(name='__profile__', sheetSize=
    2.0)
mdb.models['ExampleB_1Elem'].sketches['__profile__'].Line(point1=(0.0, 0.0), 
    point2=(1.2, 0.0))
mdb.models['ExampleB_1Elem'].Part(dimensionality=TWO_D_PLANAR, name='Beam', 
    type=DEFORMABLE_BODY)
mdb.models['ExampleB_1Elem'].parts['Beam'].BaseWire(sketch=
    mdb.models['ExampleB_1Elem'].sketches['__profile__'])
del mdb.models['ExampleB_1Elem'].sketches['__profile__']
mdb.models['ExampleB_1Elem'].Material(name='Steel')
mdb.models['ExampleB_1Elem'].materials['Steel'].Elastic(table=((210000000000.0, 
    0.3), ))
mdb.models['ExampleB_1Elem'].RectangularProfile(a=0.02, b=0.04, name=
    'Rect_20x40')
mdb.models['ExampleB_1Elem'].BeamSection(consistentMassMatrix=False, 
    integration=DURING_ANALYSIS, material='Steel', name='BeamSection', 
    poissonRatio=0.3, profile='Rect_20x40', temperatureVar=LINEAR)
mdb.models['ExampleB_1Elem'].parts['Beam'].SectionAssignment(offset=0.0, 
    offsetField='', offsetType=MIDDLE_SURFACE, region=Region(
    edges=mdb.models['ExampleB_1Elem'].parts['Beam'].edges.getSequenceFromMask(
    mask=('[#1 ]', ), )), sectionName='BeamSection', thicknessAssignment=
    FROM_SECTION)
mdb.models['ExampleB_1Elem'].rootAssembly.DatumCsysByDefault(CARTESIAN)
mdb.models['ExampleB_1Elem'].rootAssembly.Instance(dependent=ON, name='Beam-1', 
    part=mdb.models['ExampleB_1Elem'].parts['Beam'])
mdb.models['ExampleB_1Elem'].rootAssembly.Set(name='FIXED_END', vertices=
    mdb.models['ExampleB_1Elem'].rootAssembly.instances['Beam-1'].vertices.getSequenceFromMask(
    mask=('[#1 ]', ), ))
mdb.models['ExampleB_1Elem'].rootAssembly.Set(name='FREE_END', vertices=
    mdb.models['ExampleB_1Elem'].rootAssembly.instances['Beam-1'].vertices.getSequenceFromMask(
    mask=('[#2 ]', ), ))
mdb.models['ExampleB_1Elem'].StaticStep(name='LoadStep', nlgeom=OFF, previous=
    'Initial')
mdb.models['ExampleB_1Elem'].DisplacementBC(createStepName='Initial', name=
    'Encastre', region=
    mdb.models['ExampleB_1Elem'].rootAssembly.sets['FIXED_END'], u1=0.0, u2=0.0
    , ur3=0.0)
mdb.models['ExampleB_1Elem'].ConcentratedForce(cf1=10000.0, createStepName=
    'LoadStep', name='Axial_Tension', region=
    mdb.models['ExampleB_1Elem'].rootAssembly.sets['FREE_END'])
mdb.models['ExampleB_1Elem'].ConcentratedForce(cf2=-600.0, createStepName=
    'LoadStep', name='Vertical_Load', region=
    mdb.models['ExampleB_1Elem'].rootAssembly.sets['FREE_END'])
mdb.models['ExampleB_1Elem'].fieldOutputRequests['F-Output-1'].setValues(
    variables=('S', 'U', 'RF', 'SF', 'SM'))
#* Invalid variables are specified in an output request.  An output request 
#* cannot be created in a step where some variables are invalid.
