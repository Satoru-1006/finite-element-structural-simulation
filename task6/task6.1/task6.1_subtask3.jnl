mdb.Model(name='Task3_A_PortalFrame')
mdb.models['Task3_A_PortalFrame'].ConstrainedSketch(name='__profile__', 
    sheetSize=10.0)
mdb.models['Task3_A_PortalFrame'].sketches['__profile__'].Line(point1=(0.0, 
    0.0), point2=(0.0, 2.0))
mdb.models['Task3_A_PortalFrame'].sketches['__profile__'].Line(point1=(0.0, 
    2.0), point2=(3.0, 2.0))
mdb.models['Task3_A_PortalFrame'].Part(dimensionality=TWO_D_PLANAR, name=
    'PortalFrame', type=DEFORMABLE_BODY)
mdb.models['Task3_A_PortalFrame'].parts['PortalFrame'].BaseWire(sketch=
    mdb.models['Task3_A_PortalFrame'].sketches['__profile__'])
del mdb.models['Task3_A_PortalFrame'].sketches['__profile__']
mdb.models['Task3_A_PortalFrame'].Material(name='Steel')
mdb.models['Task3_A_PortalFrame'].materials['Steel'].Elastic(table=((
    210000000000.0, 0.3), ))
mdb.models['Task3_A_PortalFrame'].RectangularProfile(a=0.00912870929175277, b=
    0.219089023002066, name='EquivalentRect_A_I')
mdb.models['Task3_A_PortalFrame'].BeamSection(consistentMassMatrix=False, 
    integration=DURING_ANALYSIS, material='Steel', name='FrameSection', 
    poissonRatio=0.3, profile='EquivalentRect_A_I', temperatureVar=LINEAR)
mdb.models['Task3_A_PortalFrame'].parts['PortalFrame'].SectionAssignment(
    offset=0.0, offsetField='', offsetType=MIDDLE_SURFACE, region=Region(
    edges=mdb.models['Task3_A_PortalFrame'].parts['PortalFrame'].edges.getSequenceFromMask(
    mask=('[#3 ]', ), )), sectionName='FrameSection', thicknessAssignment=
    FROM_SECTION)
mdb.models['Task3_A_PortalFrame'].rootAssembly.DatumCsysByDefault(CARTESIAN)
mdb.models['Task3_A_PortalFrame'].rootAssembly.Instance(dependent=ON, name=
    'PortalFrame-1', part=
    mdb.models['Task3_A_PortalFrame'].parts['PortalFrame'])
mdb.models['Task3_A_PortalFrame'].rootAssembly.Set(name='N1_FIXED', vertices=
    mdb.models['Task3_A_PortalFrame'].rootAssembly.instances['PortalFrame-1'].vertices.getSequenceFromMask(
    mask=('[#1 ]', ), ))
mdb.models['Task3_A_PortalFrame'].rootAssembly.Set(name='N2', vertices=
    mdb.models['Task3_A_PortalFrame'].rootAssembly.instances['PortalFrame-1'].vertices.getSequenceFromMask(
    mask=('[#2 ]', ), ))
mdb.models['Task3_A_PortalFrame'].rootAssembly.Set(name='N3_LOAD', vertices=
    mdb.models['Task3_A_PortalFrame'].rootAssembly.instances['PortalFrame-1'].vertices.getSequenceFromMask(
    mask=('[#4 ]', ), ))
mdb.models['Task3_A_PortalFrame'].StaticStep(name='LoadStep', nlgeom=OFF, 
    previous='Initial')
mdb.models['Task3_A_PortalFrame'].DisplacementBC(createStepName='Initial', 
    name='Fixed_N1', region=
    mdb.models['Task3_A_PortalFrame'].rootAssembly.sets['N1_FIXED'], u1=0.0, 
    u2=0.0, ur3=0.0)
mdb.models['Task3_A_PortalFrame'].ConcentratedForce(cf1=20000.0, 
    createStepName='LoadStep', name='Fx_20kN', region=
    mdb.models['Task3_A_PortalFrame'].rootAssembly.sets['N3_LOAD'])
mdb.models['Task3_A_PortalFrame'].ConcentratedForce(cf2=-10000.0, 
    createStepName='LoadStep', name='Fy_minus10kN', region=
    mdb.models['Task3_A_PortalFrame'].rootAssembly.sets['N3_LOAD'])
mdb.models['Task3_A_PortalFrame'].HistoryOutputRequest(createStepName=
    'LoadStep', name='N2History', region=
    mdb.models['Task3_A_PortalFrame'].rootAssembly.sets['N2'], variables=('U1', 
    'U2', 'UR3'))
mdb.models['Task3_A_PortalFrame'].HistoryOutputRequest(createStepName=
    'LoadStep', name='N3History', region=
    mdb.models['Task3_A_PortalFrame'].rootAssembly.sets['N3_LOAD'], variables=(
    'U1', 'U2', 'UR3'))
mdb.models['Task3_A_PortalFrame'].parts['PortalFrame'].seedPart(
    deviationFactor=0.1, minSizeFactor=0.1, size=10.0)
mdb.models['Task3_A_PortalFrame'].parts['PortalFrame'].setElementType(
    elemTypes=(ElemType(elemCode=B21, elemLibrary=STANDARD), ), regions=(
    mdb.models['Task3_A_PortalFrame'].parts['PortalFrame'].edges.getSequenceFromMask(
    mask=('[#3 ]', ), ), ))
mdb.models['Task3_A_PortalFrame'].parts['PortalFrame'].generateMesh()
