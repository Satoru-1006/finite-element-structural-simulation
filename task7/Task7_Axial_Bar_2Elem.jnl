    sectionName='BarSection')
mdb.models['Task7_Axial_Bar_2Elem'].parts['Bar_1D_T2D2'].setElementType(
    elemTypes=(ElemType(elemCode=T2D2, elemLibrary=STANDARD), ), regions=(
