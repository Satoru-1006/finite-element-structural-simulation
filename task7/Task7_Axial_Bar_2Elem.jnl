    mask=('[#3 ]', ), ), ))
mdb.models['Task7_Axial_Bar_2Elem'].rootAssembly.DatumCsysByDefault(CARTESIAN)
mdb.models['Task7_Axial_Bar_2Elem'].rootAssembly.Instance(dependent=ON, name=
    'Bar-1', part=mdb.models['Task7_Axial_Bar_2Elem'].parts['Bar_1D_T2D2'])
mdb.models['Task7_Axial_Bar_2Elem'].StaticStep(name='Axial_Load', nlgeom=OFF, 
    previous='Initial')
mdb.models['Task7_Axial_Bar_2Elem'].fieldOutputRequests['F-Output-1'].setValues(
    variables=('S', 'E', 'U', 'RF', 'CF'))
mdb.models['Task7_Axial_Bar_2Elem'].DisplacementBC(amplitude=UNSET, 
    createStepName='Initial', distributionType=UNIFORM, fieldName='', 
    localCsys=None, name='Left_axial_fixed', region=
