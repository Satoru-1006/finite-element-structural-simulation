    , u1=0.0, u2=0.0, ur3=UNSET)
mdb.models['Task7_Axial_Bar_2Elem'].DisplacementBC(amplitude=UNSET, 
    createStepName='Initial', distributionType=UNIFORM, fieldName='', 
    localCsys=None, name='Suppress_transverse_motion', region=
    mdb.models['Task7_Axial_Bar_2Elem'].rootAssembly.instances['Bar-1'].sets['ALL_NODES']
    , u1=UNSET, u2=0.0, ur3=UNSET)
mdb.models['Task7_Axial_Bar_2Elem'].ConcentratedForce(cf1=5000.0, 
    createStepName='Axial_Load', name='Eq_dist_load_left', region=
    mdb.models['Task7_Axial_Bar_2Elem'].rootAssembly.instances['Bar-1'].sets['LEFT_NODE'])
mdb.models['Task7_Axial_Bar_2Elem'].ConcentratedForce(cf1=10000.0, 
    createStepName='Axial_Load', name='Eq_dist_load_mid', region=
    mdb.models['Task7_Axial_Bar_2Elem'].rootAssembly.instances['Bar-1'].sets['MID_NODE'])
mdb.models['Task7_Axial_Bar_2Elem'].ConcentratedForce(cf1=1005000.0, 
    createStepName='Axial_Load', name='Right_P_plus_dist', region=
    mdb.models['Task7_Axial_Bar_2Elem'].rootAssembly.instances['Bar-1'].sets['RIGHT_NODE'])
mdb.Job(description=
    'Task 7 axial bar: L=1000 mm, E=200000 N/mm2, A=100 mm2, two T2D2 elements, equivalent nodal distributed load.'
    , model='Task7_Axial_Bar_2Elem', name='Task7_Axial_Bar_2Elem')
